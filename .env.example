# Application Settings
APP_NAME=Resume Parser API
APP_VERSION=1.0.0
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000

# File Upload Settings
MAX_FILE_SIZE_MB=10

# NLP Settings
SPACY_MODEL=en_core_web_md

# Logging
LOG_LEVEL=INFO

# Paths
DATA_DIR=data

# Exact allowed frontend origins, expressed as JSON. Add an authorised Sites origin explicitly.
CORS_ORIGINS=["https://resume.docheng.co.za","http://localhost:3000","http://127.0.0.1:3000"]
# Production requires true and HTTPS. Set false only for local HTTP development.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Optional: stable random server secret (32+ chars). If omitted a private key is generated in DATA_DIR.
# WORKSPACE_SECRET=
# Optional paid writing provider, activated only when a key AND an explicit model are configured.
# Never put this key in NEXT_PUBLIC_ variables.
# AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
RATE_LIMIT_REQUESTS=60
AI_REQUESTS_PER_MINUTE=10

# Optional separate directory for immutable parsing taxonomies (defaults to DATA_DIR).
# TAXONOMY_DIR=data
